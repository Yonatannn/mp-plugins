{
  "name": "mp-plugins-devcontainer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "MISSION_PLANNER_DIR": "/opt/mission-planner"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp"
      ],
      "settings": {
        "dotnet.defaultSolution": "SoftwareLabPlugins.sln"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postStartCommand": "bash .devcontainer/validate-mission-planner.sh"
}
