<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath>../build/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>../build/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MissionPlanner">
      <HintPath>$(MissionPlannerDir)MissionPlanner.exe</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="MissionPlanner.Comms">
      <HintPath>$(MissionPlannerDir)MissionPlanner.Comms.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="MissionPlanner.ArduPilot">
      <HintPath>$(MissionPlannerDir)MissionPlanner.ArduPilot.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="MissionPlanner.MAVLink">
      <HintPath>$(MissionPlannerDir)MAVLink.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="MissionPlanner.Interfaces">
      <HintPath>$(MissionPlannerDir)Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SoftwareLabNotificationsPlugin/SoftwareLabNotificationsPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../SoftwareLabPlugin.Shared/SoftwareLabPluginBase.cs" Link="Shared/SoftwareLabPluginBase.cs" />
  </ItemGroup>

</Project>
